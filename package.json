{
  "name": "@outloud/reqo",
  "type": "module",
  "version": "3.0.0",
  "description": "HTTP client based on Fetch API with built-in support for retries, timeouts, and JSON handling.",
  "homepage": "https://docs.outloud.dev/reqo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madebyoutloud/reqo.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "migrations",
    "skills"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins/*": {
      "types": "./dist/plugins/*.d.ts",
      "import": "./dist/plugins/*.js"
    }
  },
  "imports": {
    "#/*": "./src/*.js"
  },
  "keywords": [
    "http",
    "fetch",
    "request",
    "api"
  ],
  "scripts": {
    "dev": "vitest dev",
    "test": "vitest run",
    "bench": "vitest bench",
    "build": "tsdown",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "release": "release-it"
  },
  "devDependencies": {
    "@outloud/oxfmt-config": "^2.0.2",
    "@outloud/oxlint-config": "^2.0.2",
    "@types/node": "^24.10.0",
    "msw": "^2.11.6",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "release-it": "^19.0.5",
    "tsdown": "^0.15.12",
    "typescript": "~5.8",
    "vitest": "^1.5.0"
  }
}
